# VELTRIX backend configuration
# Copy this file to ".env" and fill in values. NEVER commit the real .env file.

# Flask environment: development | production
FLASK_ENV=development

# Secret key used to sign session cookies and CSRF tokens.
# Generate a strong random value, e.g.: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Database location. For local development SQLite is used by default when this
# is left unset (stored at backend/instance/veltrix.db).
# Example for Postgres on a hosted provider:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/veltrix
DATABASE_URL=

# Set to 1 to send cookies only over HTTPS (required in production).
SESSION_COOKIE_SECURE=0

# Comma separated list of frontend origins allowed to call the JSON API.
# Only set this if the GitHub Pages frontend must call this backend.
CORS_ORIGINS=

# Development-only administrator bootstrap account.
# If both are set, "flask seed" creates an admin account with these values.
# DO NOT deploy with a predictable password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Veltrix Admin

# Starting demo cash balance for every new demo account (fictional funds).
DEMO_STARTING_BALANCE=10000.00
